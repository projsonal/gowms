APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=t4mp4n
DB_NAME=stockrsd
DB_SSLMODE=disable

# WhatsApp — pilih salah satu driver:
# - "gateway" (default): HTTP call ke gateway berbayar, isi 3 baris di bawah.
# - "whatsmeow": sesi WhatsApp Web sendiri, GRATIS, tapi wajib pairing dulu
#   lewat `go run ./cmd/whatsapp-pair` (scan QR). Lihat pkg/wa/whatsmeow_sender.go.
#   KALAU OTP TIDAK PERNAH SAMPAI DAN DRIVER=gateway TAPI WHATSAPP_API_URL
#   KOSONG, ITU PENYEBABNYA — cek log server saat startup, ada PERINGATAN eksplisit.
WHATSAPP_DRIVER=gateway
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER=wms-RSD
WHATSMEOW_SESSION_PATH=./var/whatsmeow-session.db

# SMS gateway (alternatif WhatsApp untuk OTP) — sama seperti WhatsApp,
# kalau kosong pengiriman SMS akan selalu gagal (ada peringatan di log startup).
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=wms-RSD

# Token sesi "lupa password" (JWT terpisah dari JWT login)
PASSWORD_RESET_SECRET=change-me-password-reset-secret
PASSWORD_RESET_TTL_MINUTES=10